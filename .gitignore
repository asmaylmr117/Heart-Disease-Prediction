# =============================================
# Cloud Horizons - .gitignore
# =============================================

# ---------- OS Files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/

# ---------- Node / Package Managers ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnp.*
.yarn/

# ---------- Build Output ----------
dist/
build/
out/
.cache/
.parcel-cache/

# ---------- Environment ----------
.env
.env.local
.env.*.local

# ---------- Logs ----------
*.log
logs/

# ---------- Temp Files ----------
*.tmp
*.temp
*.bak
*.old

# ---------- Misc ----------
.gemini/
